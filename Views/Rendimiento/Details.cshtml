@model HRM.SantaLucia.Web.Models.ViewModels.RendimientoViewModel
@{
    ViewData["Title"] = "Detalles de Evaluación";
}

<div class="row">
    <div class="col-12">
        <h1 class="mb-4">Detalles de Evaluación de Rendimiento</h1>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h5>Información General</h5>
    </div>
    <div class="card-body">
        <div class="row mb-3">
            <div class="col-md-6">
                <strong>Empleado:</strong> @Model.NombreEmpleado
            </div>
            <div class="col-md-6">
                <strong>Evaluador:</strong> @Model.NombreEvaluador
            </div>
        </div>
        <div class="row mb-3">
            <div class="col-md-6">
                <strong>Fecha de Evaluación:</strong> @Model.FechaEvaluacion.ToString("dd/MM/yyyy")
            </div>
            <div class="col-md-6">
                <strong>Período:</strong> @Model.PeriodoEvaluacion
            </div>
        </div>
        <div class="row mb-3">
            <div class="col-md-6">
                <strong>Calificación General:</strong> 
                <span class="badge @(Model.CalificacionGeneral >= 4 ? "bg-success" : Model.CalificacionGeneral >= 3 ? "bg-warning" : "bg-danger")">
                    @Model.CalificacionGeneral.ToString("F2") / 5.0
                </span>
            </div>
            <div class="col-md-6">
                <strong>% Cumplimiento de Metas:</strong> @Model.PorcentajeCumplimiento.ToString("F1")%
            </div>
        </div>
    </div>
</div>

<div class="card mt-3">
    <div class="card-header">
        <h5>Metas</h5>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <strong>Metas Propuestas:</strong> @Model.MetasPropuestas
            </div>
            <div class="col-md-6">
                <strong>Metas Alcanzadas:</strong> @Model.MetasAlcanzadas
            </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Comentarios))
{
    <div class="card mt-3">
        <div class="card-header">
            <h5>Comentarios</h5>
        </div>
        <div class="card-body">
            <p>@Model.Comentarios</p>
        </div>
    </div>
}

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</div>

