@model HRM.SantaLucia.Web.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<!-- Hero con logo Complejo Educativo Santa Lucía -->
<div class="row mb-4">
    <div class="col-12 text-center py-4 px-3 rounded-3" style="background: linear-gradient(135deg, var(--santalucia-azul) 0%, #2a6ba0 100%);">
        <img src="~/images/logo-santa-lucia.png" alt="Complejo Educativo Santa Lucía" class="img-fluid mb-3" style="max-height: 120px;" />
        <h1 class="text-white mb-1" style="font-weight: 600;">Sistema de Gestión de Recursos Humanos</h1>
        <p class="text-white mb-0 opacity-90">Complejo Educativo Santa Lucía</p>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-3 mb-3">
        <div class="card text-white border-0 shadow-sm h-100" style="background-color: var(--santalucia-teal);">
            <div class="card-body d-flex flex-column">
                <h5 class="card-title">Empleados Activos</h5>
                <h2 class="card-text mt-auto">@Model.TotalEmpleadosActivos</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card text-white border-0 shadow-sm h-100" style="background-color: var(--santalucia-purpura);">
            <div class="card-body d-flex flex-column">
                <h5 class="card-title">Docentes</h5>
                <h2 class="card-text mt-auto">@Model.TotalDocentes</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card text-white border-0 shadow-sm h-100" style="background-color: var(--santalucia-slate);">
            <div class="card-body d-flex flex-column">
                <h5 class="card-title">Administrativos</h5>
                <h2 class="card-text mt-auto">@Model.TotalAdministrativos</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card text-white border-0 shadow-sm h-100" style="background-color: var(--santalucia-azul);">
            <div class="card-body d-flex flex-column">
                <h5 class="card-title">Vacaciones Pendientes</h5>
                <h2 class="card-text mt-auto">@Model.VacacionesPendientes</h2>
            </div>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-6 mb-3">
        <div class="card border-0 shadow-sm">
            <div class="card-header text-white" style="background-color: var(--santalucia-teal);">
                <h5 class="mb-0">Nómina del Mes</h5>
            </div>
            <div class="card-body">
                <h3 style="color: var(--santalucia-azul);">@Model.TotalNominaMes.ToString("C")</h3>
                <p class="text-muted mb-0">Promedio: @Model.PromedioSalario.ToString("C")</p>
            </div>
        </div>
    </div>
    <div class="col-md-6 mb-3">
        <div class="card border-0 shadow-sm">
            <div class="card-header text-white" style="background-color: var(--santalucia-purpura);">
                <h5 class="mb-0">Asistencia de Hoy</h5>
            </div>
            <div class="card-body">
                <h3 style="color: var(--santalucia-azul);">@Model.AsistenciaHoy</h3>
                <p class="text-muted mb-0">Registros de asistencia</p>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card border-0 shadow-sm">
            <div class="card-header text-white" style="background-color: var(--santalucia-slate);">
                <h5 class="mb-0">Accesos Rápidos</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3 mb-2">
                        <a asp-controller="Empleado" asp-action="Create" class="btn w-100 btn-santalucia-azul">Nuevo Empleado</a>
                    </div>
                    <div class="col-md-3 mb-2">
                        <a asp-controller="Asistencia" asp-action="Registrar" class="btn w-100 btn-santalucia-teal">Registrar Asistencia</a>
                    </div>
                    <div class="col-md-3 mb-2">
                        <a asp-controller="Nomina" asp-action="Index" class="btn w-100 btn-santalucia-purpura">Calcular Nómina</a>
                    </div>
                    <div class="col-md-3 mb-2">
                        <a asp-controller="Vacaciones" asp-action="Solicitar" class="btn w-100 btn-santalucia-slate">Solicitar Vacaciones</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
