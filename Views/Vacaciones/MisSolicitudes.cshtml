@model IEnumerable<HRM.SantaLucia.Web.Models.ViewModels.VacacionesViewModel>
@{
    ViewData["Title"] = "Mis Solicitudes de Vacaciones";
    var empleadoKey = ViewBag.EmpleadoKey as int?;
    var diasDisponibles = ViewBag.DiasDisponibles as int?;
}

<div class="row">
    <div class="col-12">
        <h1 class="mb-4">Mis Solicitudes de Vacaciones</h1>
    </div>
</div>

@if (diasDisponibles.HasValue)
{
    <div class="alert alert-info mb-3">
        <strong>Días disponibles:</strong> @diasDisponibles
    </div>
}

<div class="row mb-3">
    <div class="col-md-12 text-end">
        <a asp-action="Solicitar" asp-route-empleadoKey="@empleadoKey" class="btn btn-success">Nueva Solicitud</a>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Fecha Inicio</th>
                    <th>Fecha Fin</th>
                    <th>Días Solicitados</th>
                    <th>Estado</th>
                    <th>Fecha Solicitud</th>
                    <th>Fecha Aprobación</th>
                    <th>Aprobador</th>
                    <th>Observaciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model.OrderByDescending(v => v.FechaSolicitud))
                    {
                        <tr>
                            <td>@item.FechaInicio.ToString("dd/MM/yyyy")</td>
                            <td>@item.FechaFin.ToString("dd/MM/yyyy")</td>
                            <td>@item.DiasSolicitados</td>
                            <td>
                                @if (item.Estado == "Aprobada")
                                {
                                    <span class="badge bg-success">@item.Estado</span>
                                }
                                else if (item.Estado == "Rechazada")
                                {
                                    <span class="badge bg-danger">@item.Estado</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">@item.Estado</span>
                                }
                            </td>
                            <td>@item.FechaSolicitud.ToString("dd/MM/yyyy")</td>
                            <td>@(item.FechaAprobacion?.ToString("dd/MM/yyyy") ?? "-")</td>
                            <td>@(item.NombreAprobador ?? "-")</td>
                            <td>@item.Observaciones</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center">No hay solicitudes de vacaciones</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</div>

