@model HRM.SantaLucia.Web.Models.ViewModels.EditarNominaViewModel
@{
    ViewData["Title"] = "Editar Nómina";
}

<div class="row">
    <div class="col-12">
        <h1 class="mb-4">Editar Nómina</h1>
        <p class="text-muted">Empleado: <strong>@Model.NombreEmpleado</strong> | Salario base (mensual): <strong>@Model.SalarioBase.ToString("C")</strong></p>
<p class="small text-muted">Fórmulas: Hora regular = Salario base/30/8 | Horas extras = Hora regular × 1.5 × qty | Feriados = (Salario base/30) × 2 × días feriados</p>
    </div>
</div>

<hr />

<div class="row">
    <div class="col-md-8">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="NominaKey" />
            <input type="hidden" asp-for="EmpleadoKey" />
            <input type="hidden" asp-for="NombreEmpleado" />
            <input type="hidden" asp-for="SalarioBase" />
            <input type="hidden" asp-for="MesPeriodo" />

            <h5 class="mt-3 mb-3">Valores Editables</h5>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="QTYHorasRegulares" class="control-label"></label>
                        <input asp-for="QTYHorasRegulares" class="form-control" type="number" step="0.01" min="0" />
                        <span asp-validation-for="QTYHorasRegulares" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="QTYHorasExtras" class="control-label"></label>
                        <input asp-for="QTYHorasExtras" class="form-control" type="number" step="0.01" min="0" />
                        <span asp-validation-for="QTYHorasExtras" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="Miscelaneo" class="control-label"></label>
                        <input asp-for="Miscelaneo" class="form-control" type="number" step="0.01" min="0" />
                        <span asp-validation-for="Miscelaneo" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="QTYDiasFeriados" class="control-label"></label>
                        <input asp-for="QTYDiasFeriados" class="form-control" type="number" step="0.01" min="0" />
                        <span class="small text-muted">Cantidad de días feriados (el monto se calcula: salario diario × 2 × días)</span>
                        <span asp-validation-for="QTYDiasFeriados" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <p class="small text-muted mt-2">El aguinaldo se calcula automáticamente: en diciembre se paga 1/12 del salario base; en otros meses no se agrega.</p>

            <h5 class="mt-4 mb-3">Extras y Deducciones Quincenales</h5>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="ExtrasQuincenales" class="control-label"></label>
                        <input asp-for="ExtrasQuincenales" class="form-control" type="number" step="0.01" min="0" />
                        <span asp-validation-for="ExtrasQuincenales" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="DeduccionesQuincenales" class="control-label"></label>
                        <input asp-for="DeduccionesQuincenales" class="form-control" type="number" step="0.01" min="0" />
                        <span asp-validation-for="DeduccionesQuincenales" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="form-group mt-4">
                <input type="submit" value="Guardar Cambios" class="btn btn-primary" />
                <a asp-action="Consultar" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
