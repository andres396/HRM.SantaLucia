@model HRM.SantaLucia.Web.Models.ViewModels.CalcularNominaViewModel
@{
    ViewData["Title"] = "Nómina";
}

<div class="row">
    <div class="col-12">
        <h1 class="mb-4">Cálculo de Nómina</h1>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5>Calcular Nómina</h5>
            </div>
            <div class="card-body">
                <form asp-action="Calcular" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="form-group mb-3">
                        <label asp-for="Ano" class="control-label"></label>
                        <input asp-for="Ano" class="form-control" min="2020" max="2030" />
                        <span asp-validation-for="Ano" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Mes" class="control-label"></label>
                        <select asp-for="Mes" class="form-control">
                            @for (int i = 1; i <= 12; i++)
                            {
                                <option value="@i">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(i)</option>
                            }
                        </select>
                        <span asp-validation-for="Mes" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Quincena" class="control-label"></label>
                        <select asp-for="Quincena" class="form-control">
                            <option value="1">Primera Quincena (1-15)</option>
                            <option value="2">Segunda Quincena (16-fin de mes)</option>
                        </select>
                        <span asp-validation-for="Quincena" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Sede" class="control-label"></label>
                        <select asp-for="Sede" class="form-control">
                            <option value="Kamakiri">Kamakiri</option>
                            <option value="Complejo Educativo">Complejo Educativo</option>
                        </select>
                        <span asp-validation-for="Sede" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <input type="submit" value="Calcular Nómina" class="btn btn-primary" />
                        <a asp-action="Consultar" asp-route-ano="@Model.Ano" asp-route-mes="@Model.Mes" asp-route-quincena="@Model.Quincena" asp-route-sede="@Model.Sede" class="btn btn-secondary">Consultar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

